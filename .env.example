CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
RESEND_API_KEY=

# Shopify Storefront API. The domain/version defaults match the current store,
# so only the private Headless token is required for tags and drop metafields.
SHOPIFY_STORE_DOMAIN=bassbingebaits.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-01
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Server-only durable catalog state. Connect an Upstash Redis integration
# through Vercel Marketplace; either supported variable pair is accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# The catalog namespace is derived from schema, Shopify shop, and Vercel trust
# identity. Leave CATALOG_CACHE_NAMESPACE unset; a manual value is accepted only
# when it exactly matches that canonical identity.
# CATALOG_CACHE_NAMESPACE=

# Server-only webhook and protected operational endpoint secrets.
SHOPIFY_WEBHOOK_SECRET=
CATALOG_HEALTH_TOKEN=
CRON_SECRET=
