{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/shop/:category(jigs|trailers|apparel)",
      "destination": "/shop"
    },
    {
      "source": "/products/:handle",
      "destination": "/api/product?handle=:handle"
    }
  ],
  "crons": [
    {
      "path": "/api/catalog-reconcile",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products/peewee-football",
      "destination": "/products/7-16-oz-peewee-football-jig",
      "permanent": true
    },
    {
      "source": "/products/peewee-football-hd",
      "destination": "/products/premium-football-jig",
      "permanent": true
    },
    {
      "source": "/products/peewee-spider-hd",
      "destination": "/products/5-16-peewee-spider-hd-finesse-cut",
      "permanent": true
    },
    {
      "source": "/products/heavy-cover-football",
      "destination": "/products/3-4-oz-football-jig",
      "permanent": true
    },
    {
      "source": "/products/finesse-jig",
      "destination": "/products/5-16-oz-finesse-jig",
      "permanent": true
    },
    {
      "source": "/products/:handle.html",
      "destination": "/products/:handle",
      "permanent": true
    }
  ]
}
